# proxy
#export NO_PROXY=localhost

# aliases
. ~/.shell_aliases

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# ASDF via Homebrew
. /home/linuxbrew/.linuxbrew/opt/asdf/libexec/asdf.sh
fpath=($HOME/.linuxbrew/opt/asdf/completions $fpath)
autoload -Uz compinit
compinit


# AWS
#export AWS_PROFILE=default
export AWS_PROFILE=bu-recurrence-dev
function aws-profile-select() {
  # Lista perfis do ~/.aws/config (removendo prefixo 'profile ' e linhas vazias)
  profiles=$(grep '^\[profile ' ~/.aws/config | sed 's/^\[profile \(.*\)\]$/\1/')

  # Passa os perfis para o fzf para seleção
  selected=$(echo "$profiles" | fzf --prompt="Selecione AWS Profile: ")

  if [[ -n "$selected" ]]; then
    export AWS_PROFILE="$selected"
    echo "AWS_PROFILE setado para: $AWS_PROFILE"
  else
    echo "Nenhum profile selecionado."
  fi
}


