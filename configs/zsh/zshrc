# --- ASDF version manager (optional) ---
# Linux via Homebrew:
# . /home/linuxbrew/.linuxbrew/opt/asdf/libexec/asdf.sh
# macOS via Homebrew:
# . /opt/homebrew/opt/asdf/libexec/asdf.sh

# --- FZF ---
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# --- Starship prompt (MUST be at the end) ---
eval "$(starship init zsh)"
