# ======================================================================
# ZSH Configuration - Terminal Setup
# ======================================================================

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Using Starship prompt instead

plugins=(
	git
	zsh-syntax-highlighting
	zsh-autosuggestions
	bgnotify
	command-not-found
)

source $ZSH/oh-my-zsh.sh

# --- Environment ---
export EDITOR=vim

# --- Zoxide (smart cd) ---
eval "$(zoxide init zsh)"

# --- Aliases ---
[ -f ~/.shell_aliases ] && source ~/.shell_aliases

# --- Homebrew ---
